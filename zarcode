<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D Qo'l Boshqaruvi</title>
    <style>
        body { margin: 0; overflow: hidden; background-color: #000; font-family: 'Segoe UI', sans-serif; }
        
        /* Kamera orqa foni (To'liq ekran) */
        #video-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            transform: scaleX(-1); /* Oyna effekti */
            opacity: 0.4; /* Zarrachalar yaxshiroq ko'rinishi uchun xira fon */
        }
        video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* 3D Sahna */
        #canvas-container { 
            position: absolute; 
            top: 0; 
            left: 0; 
            width: 100%; 
            height: 100%; 
            z-index: 1; 
        }
        
        /* UI Matnlari */
        #ui-layer {
            position: absolute;
            top: 20px;
            left: 20px;
            z-index: 10;
            color: white;
            pointer-events: none;
            text-shadow: 0px 0px 5px rgba(0,0,0,0.8);
        }
        h1 { margin: 0; font-size: 1.8rem; text-transform: uppercase; letter-spacing: 2px; color: #00d2ff; }
        p { font-size: 1.1rem; color: #fff; max-width: 400px; line-height: 1.5; }
        .instruction { font-weight: bold; color: #ffeb3b; }

        /* Yuklash ekrani */
        #overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.9);
            z-index: 20;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
        }
        #start-btn {
            padding: 15px 40px;
            background: #00d2ff;
            border: none;
            border-radius: 30px;
            color: #000;
            font-weight: bold;
            font-size: 1.2rem;
            cursor: pointer;
            transition: transform 0.2s, background 0.2s;
            pointer-events: auto;
        }
        #start-btn:hover {
            transform: scale(1.05);
            background: #ffffff;
        }
        #loading-text {
            margin-top: 20px;
            font-size: 1rem;
            color: #888;
        }
        .hidden { display: none !important; }
    </style>

    <!-- Kutubxonalar -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/control_utils/control_utils.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/drawing_utils/drawing_utils.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js" crossorigin="anonymous"></script>
</head>
<body>

    <div id="overlay">
        <button id="start-btn">KAMERANI YOQISH VA BOSHLASH</button>
        <div id="loading-text">Foydalanuvchi kutilmoqda...</div>
    </div>

    <div id="ui-layer">
        <h1>Zarrachalar Sehrgari</h1>
        <p>
            <span class="instruction">Musht qiling:</span> Zarrachalar qo'lga yig'iladi.<br>
            <span class="instruction">Qo'lni oching:</span> Zarrachalar tarqaladi.<br>
            Qo'lingizni harakatlantirib ularni boshqaring.
        </p>
    </div>

    <div id="video-container">
        <video id="input-video"></video>
    </div>

    <div id="canvas-container"></div>

<script>
    // --- SOZLAMALAR ---
    const PARTICLE_COUNT = 6000;
    const REPULSION_RADIUS = 60; // Tarqalish radiusi
    const GATHER_SPEED = 0.08;   // Yig'ilish tezligi
    
    // --- O'ZGARUVCHILAR ---
    let scene, camera, renderer;
    let particles, positions, originalPositions;
    let handMesh; 
    let handPosition = new THREE.Vector3(9999, 9999, 9999);
    let isHandDetected = false;
    let isFist = false; // Musht holati
    let clock = new THREE.Clock();

    const videoElement = document.getElementById('input-video');
    const startBtn = document.getElementById('start-btn');
    const loadingText = document.getElementById('loading-text');
    const overlay = document.getElementById('overlay');

    // --- BOSHLASH ---
    startBtn.addEventListener('click', async () => {
        startBtn.disabled = true;
        startBtn.innerText = "AI YUKLANMOQDA...";
        loadingText.innerText = "MediaPipe va WebGL ishga tushirilmoqda...";
        
        try {
            await initThreeJS();
            await initMediaPipe();
            overlay.classList.add('hidden');
        } catch (e) {
            console.error(e);
            loadingText.innerText = "Xatolik: " + e.message;
            startBtn.disabled = false;
        }
    });

    // 1. THREE.JS O'RNATISH
    function initThreeJS() {
        const container = document.getElementById('canvas-container');

        // Sahna
        scene = new THREE.Scene();
        // Orqa fon shaffof bo'lishi kerak, shunda kamera ko'rinadi
        scene.background = null; 

        // Kamera
        camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.z = 120;

        // Renderer
        renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(window.devicePixelRatio);
        container.appendChild(renderer.domElement);

        // --- ZARRACHALAR ---
        const geometry = new THREE.BufferGeometry();
        positions = new Float32Array(PARTICLE_COUNT * 3);
        originalPositions = new Float32Array(PARTICLE_COUNT * 3);
        const colors = new Float32Array(PARTICLE_COUNT * 3);

        const color = new THREE.Color();

        for (let i = 0; i < PARTICLE_COUNT; i++) {
            // Kengroq maydon bo'ylab tarqatish
            const x = (Math.random() - 0.5) * 300;
            const y = (Math.random() - 0.5) * 200;
            const z = (Math.random() - 0.5) * 100;

            positions[i * 3] = x;
            positions[i * 3 + 1] = y;
            positions[i * 3 + 2] = z;

            originalPositions[i * 3] = x;
            originalPositions[i * 3 + 1] = y;
            originalPositions[i * 3 + 2] = z;

            // Ranglar: Moviy va havo rang
            const vx = (x / 300) + 0.5;
            color.setHSL(0.6, 0.9, 0.5 + vx * 0.4);
            
            colors[i * 3] = color.r;
            colors[i * 3 + 1] = color.g;
            colors[i * 3 + 2] = color.b;
        }

        geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

        const material = new THREE.PointsMaterial({
            size: 1.5,
            vertexColors: true,
            blending: THREE.AdditiveBlending,
            depthTest: false,
            transparent: true,
            opacity: 0.9
        });

        particles = new THREE.Points(geometry, material);
        scene.add(particles);

        // --- QO'L MARKERI (Vizual yordamchi) ---
        const handGeo = new THREE.SphereGeometry(3, 16, 16);
        const handMat = new THREE.MeshBasicMaterial({ color: 0xffeb3b, wireframe: true, transparent: true, opacity: 0.5 });
        handMesh = new THREE.Mesh(handGeo, handMat);
        scene.add(handMesh);

        window.addEventListener('resize', onWindowResize, false);
        animate();
    }

    // 2. MEDIAPIPE O'RNATISH
    async function initMediaPipe() {
        const hands = new Hands({locateFile: (file) => {
            return `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`;
        }});

        hands.setOptions({
            maxNumHands: 1,
            modelComplexity: 1,
            minDetectionConfidence: 0.6, // Aniqroq ishlashi uchun oshirdik
            minTrackingConfidence: 0.6
        });

        hands.onResults(onHandsResults);

        const cameraUtils = new Camera(videoElement, {
            onFrame: async () => {
                await hands.send({image: videoElement});
            },
            width: 1280,
            height: 720
        });

        await cameraUtils.start();
    }

    // 3. AI NATIJALARINI QAYTA ISHLASH
    function onHandsResults(results) {
        if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {
            isHandDetected = true;
            const landmarks = results.multiHandLandmarks[0];
            
            // 1. Qo'l holatini aniqlash (Koordinata o'girish)
            const indexFinger = landmarks[9]; // O'rta barmoq asosi barqarorroq markaz bo'ladi
            
            const targetX = (0.5 - indexFinger.x) * 300; 
            const targetY = (0.5 - indexFinger.y) * 200; 
            const targetZ = 0; 

            // Yumshoq harakat
            handPosition.lerp(new THREE.Vector3(targetX, targetY, targetZ), 0.3);
            handMesh.position.copy(handPosition);
            handMesh.visible = true;

            // 2. MUSHT yoki OCHIQ ekanini aniqlash
            // Barmoq uchlari va bilak (0) orasidagi masofani o'lchaymiz
            const wrist = landmarks[0];
            const tips = [landmarks[8], landmarks[12], landmarks[16], landmarks[20]]; // 4 ta barmoq uchi
            
            let avgDist = 0;
            tips.forEach(tip => {
                const d = Math.sqrt(Math.pow(tip.x - wrist.x, 2) + Math.pow(tip.y - wrist.y, 2));
                avgDist += d;
            });
            avgDist /= 4;

            // Agar o'rtacha masofa kichik bo'lsa, demak musht qilingan
            // 0.2 - bu taxminiy chegara
            isFist = avgDist < 0.2;

            // Marker rangini o'zgartirish (Musht=Qizil, Ochiq=Sariq)
            handMesh.material.color.setHex(isFist ? 0xff0044 : 0xffeb3b);

        } else {
            isHandDetected = false;
            handMesh.visible = false;
        }
    }

    // 4. ANIMATSIYA HALQASI
    function animate() {
        requestAnimationFrame(animate);

        const time = clock.getElapsedTime();
        const p = particles.geometry.attributes.position.array;

        for (let i = 0; i < PARTICLE_COUNT; i++) {
            const ix = i * 3;
            const iy = i * 3 + 1;
            const iz = i * 3 + 2;

            let px = p[ix];
            let py = p[iy];
            let pz = p[iz];

            // Asl joylashuv (suzib yurish uchun)
            const homeX = originalPositions[ix];
            const homeY = originalPositions[iy] + Math.sin(time * 0.5 + ix) * 5;
            const homeZ = originalPositions[iz];

            if (isHandDetected) {
                // Qo'lga masofa
                const dx = handPosition.x - px;
                const dy = handPosition.y - py;
                const dz = handPosition.z - pz;
                const distSq = dx*dx + dy*dy + dz*dz;
                const dist = Math.sqrt(distSq);

                if (isFist) {
                    // --- MUSHT (YIG'ILISH) REJIMI ---
                    // Zarrachalar qo'l markaziga intiladi
                    
                    // Kuchli tortish kuchi
                    px += dx * GATHER_SPEED;
                    py += dy * GATHER_SPEED;
                    pz += dz * GATHER_SPEED;

                    // Biroz titrash effekti (chivinlar kabi)
                    px += (Math.random() - 0.5) * 1.5;
                    py += (Math.random() - 0.5) * 1.5;
                    pz += (Math.random() - 0.5) * 1.5;

                } else {
                    // --- OCHIQ QO'L (TARQALISH) REJIMI ---
                    // Qo'l atrofidan qochish (tarqalish)
                    
                    if (dist < REPULSION_RADIUS) {
                        const force = (REPULSION_RADIUS - dist) / REPULSION_RADIUS;
                        const pushX = (dx / dist) * -1; // Teskari yo'nalish
                        const pushY = (dy / dist) * -1;
                        const pushZ = (dz / dist) * -1;
                        
                        px += pushX * force * 15; // Kuchli tarqalish
                        py += pushY * force * 15;
                        pz += pushZ * force * 15;
                    } 
                    
                    // Sekin asl holatiga qaytish (lekin qo'l yaqinida emas)
                    else {
                        px += (homeX - px) * 0.05;
                        py += (homeY - py) * 0.05;
                        pz += (homeZ - pz) * 0.05;
                    }
                }

            } else {
                // Qo'l yo'q bo'lsa, o'z joyiga qaytish
                px += (homeX - px) * 0.02;
                py += (homeY - py) * 0.02;
                pz += (homeZ - pz) * 0.02;
            }

            p[ix] = px;
            p[iy] = py;
            p[iz] = pz;
        }

        particles.geometry.attributes.position.needsUpdate = true;
        
        // Umumiy aylanish
        if (!isFist) {
            particles.rotation.y = time * 0.05;
        }

        renderer.render(scene, camera);
    }

    function onWindowResize() {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
    }
</script>
</body>
</html>
